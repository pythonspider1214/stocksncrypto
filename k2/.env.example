#############################
# Binance API (required)
#############################
BINANCE_API_KEY=
BINANCE_API_SECRET=

#############################
# Telegram (optional but recommended)
#############################
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

#############################
# Strategy
#############################
SYMBOL=BNBUSDT
INTERVAL=15m
RSI_PERIOD=21
ENTRY_RSI=26
EXIT_RSI=80
STOP_PCT=0.08
FEE_RATE=0.001

# Allocate either a percent of USDT balance or a fixed USDT amount
ALLOCATION_PCT=0.95
ALLOCATION_USDT=0

# Order behavior
USE_LIMIT_MAKER=0
PRICE_BUFFER_BPS=5

# Runtime
LIVE_TRADING=0
STATE_PATH=
POLL_INTERVAL_SEC=5
KLINES_LIMIT=200

# Optional: custom base URL (e.g., testnet)
# BINANCE_BASE_URL=https://testnet.binance.vision
